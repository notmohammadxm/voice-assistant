{
  "name": "voice-assistant",
  "version": "0.1.3",
  "description": "Voice Assistant desktop app for Persian and English voice control.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder -wl --publish never"
  },
  "author": {
    "name": "Mohammad KhanAhmadi",
    "email": "mohammadkhxm@gmail.com"
  },
  "homepage": "https://github.com/notmohammadxm/voice-assistant",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^39.2.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.voiceassistant.smart",
    "productName": "Voice Assistant",
    "files": ["**/*", "!assets/piper/**/*"],
    "extraResources": [
      { "from": "assets/piper", "to": "piper" }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voice Assistant"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "maintainer": "Mohammad KhanAhmadi <mohammadkhxm@gmail.com>",
      "icon": "assets/logo.png",
      "category": "Utility",
      "synopsis": "Smart Voice Assistant for Persian and English"
    }
  }
}
